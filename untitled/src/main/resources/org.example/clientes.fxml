<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.ClientesViewController">
    <top>
        <VBox alignment="CENTER" prefHeight="85.0" style="-fx-background-color: #000000; -fx-padding: 10;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-text-fill: gold; -fx-font-weight: bold;" text="CLIENTES">
                    <font>
                        <Font size="30.0" />
                    </font>
                </Label>
                <Label style="-fx-text-fill: gold;" text="Registrar y gestionar clientes">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 15;">
            <children>
                <Label text="Nombre Completo">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNombre" maxWidth="350.0" prefHeight="30.0" />
                <Label text="Número de Identificación">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtIdentificacion" maxWidth="350.0" prefHeight="30.0" />
                <Label text="Teléfono">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtTelefono" maxWidth="350.0" prefHeight="30.0" />
                <Label text="Correo">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCorreo" maxWidth="350.0" prefHeight="30.0" />
            <Label text="Edad">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <TextField fx:id="txtEdad" maxWidth="350.0" prefHeight="30.0" />
            <Label text="Fecha de Registro">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <DatePicker fx:id="dpFechaRegistro" />
                <HBox alignment="CENTER" prefHeight="45.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarCliente" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #000000; -fx-text-fill: gold; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Guardar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverInicio" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #000000; -fx-text-fill: gold; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Volver">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
                <Label text="Clientes registrados">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <TableView fx:id="tablaClientes" prefHeight="180.0" prefWidth="800.0">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="190.0" text="Nombre" />
                        <TableColumn fx:id="colIdentificacion" prefWidth="120.0" text="Identificación" />
                        <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />
                        <TableColumn fx:id="colCorreo" prefWidth="190.0" text="Correo" />
                  <TableColumn fx:id="colEdad" prefWidth="100.0" text="Edad" />
                  <TableColumn fx:id="colFechaRegistro" prefWidth="150.0" text="Fecha Registro" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER" prefHeight="45.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editarCliente" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #000000; -fx-text-fill: gold; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Editar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarCliente" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: gold; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Eliminar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>

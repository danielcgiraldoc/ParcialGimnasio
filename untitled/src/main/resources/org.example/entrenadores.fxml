<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="780.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.EntrenadoresViewController">
    <top>
        <VBox alignment="CENTER" prefHeight="85.0" style="-fx-background-color: #000000; -fx-padding: 10;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-text-fill: gold; -fx-font-weight: bold;" text="ENTRENADORES">
                    <font>
                        <Font size="30.0" />
                    </font>
                </Label>
                <Label style="-fx-text-fill: gold;" text="Registrar y gestionar entrenadores">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 15;">
            <children>
                <Label text="Nombre Completo">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNombre" maxWidth="350.0" prefHeight="30.0" />
                <Label text="Número de Identificación">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtIdentificacion" maxWidth="350.0" prefHeight="30.0" />
                <Label text="Teléfono">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtTelefono" maxWidth="350.0" prefHeight="30.0" />
                <Label text="Especialidad">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            <ComboBox fx:id="cbEspecialidad" prefWidth="350.0" />
                <Label text="Valor Sesion">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtValorSesion" maxWidth="350.0" prefHeight="30.0" />
                <Label text="Asignar Plan">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            <ComboBox fx:id="cbPlan" maxWidth="350.0" prefWidth="150.0" />
            <Label text="Servicio Adicional">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <ComboBox fx:id="cbServicio" prefWidth="350.0" />
                <HBox alignment="CENTER" prefHeight="45.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarEntrenador" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #000000; -fx-text-fill: gold; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Guardar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverInicio" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #000000; -fx-text-fill: gold; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Volver">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
                <Label text="Entrenadores registrados">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <TableView fx:id="tablaEntrenadores" prefHeight="180.0" prefWidth="800.0">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                        <TableColumn fx:id="colIdentificacion" prefWidth="130.0" text="Identificación" />
                        <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />
                        <TableColumn fx:id="colEspecialidad" prefWidth="140.0" text="Especialidad" />
                        <TableColumn fx:id="colValor" prefWidth="85.0" text="Valor" />
                        <TableColumn fx:id="colPlan" prefWidth="115.0" text="Plan" />
                  <TableColumn fx:id="colServicio" prefWidth="115.0" text="Servicio" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER" prefHeight="45.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editarEntrenador" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #000000; -fx-text-fill: gold; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Editar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarEntrenador" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: gold; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Eliminar">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
